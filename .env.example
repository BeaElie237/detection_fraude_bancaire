# Copier ce fichier en .env puis adapter les valeurs (.env n'est jamais versionné)

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PAYMENTS_RAW=payments.raw
KAFKA_TOPIC_FRAUD_ALERTS=fraud.alerts
KAFKA_TOPIC_FRAUD_DECISIONS=fraud.decisions

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=instantguard
POSTGRES_USER=instantguard
POSTGRES_PASSWORD=change_me

# --- Générateur de transactions ---
GENERATOR_TX_PER_MINUTE=100
GENERATOR_FRAUD_RATE=0.005
